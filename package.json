{
  "name": "rmc-colyseus-multiplayer-server",
  "version": "0.9.17",
  "private": true,
  "type": "module",
  "main": "server.ts",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsc -p tsconfig.tools.json",
    "probe": "tsx scripts/probe.ts",
    "verify:long-session": "tsx scripts/long-lived-session.ts",
    "test": "node --import tsx --test --test-concurrency=1 multiplayer-server/test/*.ts",
    "build:client": "tsx scripts/build-client.ts",
    "check:typescript-source": "tsx scripts/check-typescript-source.ts",
    "build:probe-handlers": "tsc -p tsconfig.probes-build.json",
    "verify:client-package": "tsx scripts/verify-client-package.ts",
    "build": "npm run check:typescript-source && npm run typecheck && npm run test:local && npm run build:client && npm run build:probe-handlers",
    "verify:tools": "tsx scripts/verify-tools.ts",
    "test:local": "tsx scripts/run-local-tests.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.17.44",
    "@colyseus/schema": "4.0.26",
    "@colyseus/ws-transport": "0.17.13",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.9.11",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.17.43",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
